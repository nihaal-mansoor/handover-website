---
import "../styles/global.css";
import config from "../../site.config.ts";
import { originOf } from "@uaeprop/site-kit";
import Nameplate from "../components/Nameplate.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** JSON-LD graph for this page. */
  schema?: Record<string, unknown>;
}

const { title, description, schema } = Astro.props;
const origin = originOf(config);
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(config.og.image, origin).href;
---

<!doctype html>
<html lang="en-AE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={config.og.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}

    <!-- External file, not inline: keeps the CSP free of nonces and unsafe-inline. -->
    <script src="/consent.js" defer is:inline></script>
    <script src="/enhance.js" defer is:inline></script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nameplate />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
