---
import { Icon } from "astro-icon/components";
import type { Stage } from "../content/process.ts";

/**
 * The seven stages, as a working checklist.
 *
 * Deliberately not a React island. Native <details> gives the disclosure and
 * native checkboxes give the ticking, both without a line of JavaScript;
 * /enhance.js adds only progress persistence on top. React would have cost
 * ~61 KB gzipped to do what 1 KB of DOM code does here. (CLAUDE.md §4.1)
 */

interface Props {
  stages: readonly Stage[];
}
const { stages } = Astro.props;

const facts = [
  { key: "signs", label: "Who signs", icon: "pen-line", accent: false },
  { key: "cost", label: "Cost", icon: "banknote", accent: false },
  { key: "timing", label: "Typical timing", icon: "clock", accent: false },
  { key: "stalls", label: "Where it stalls", icon: "triangle-alert", accent: true },
] as const;
---

<div data-checklist>
  <div class="flex flex-wrap items-baseline justify-between gap-xs border-b border-rule pb-xs">
    <p class="meta m-0">Your progress</p>
    <p class="data meta m-0" data-progress aria-live="polite">{stages.length} stages</p>
  </div>

  <ol class="m-0 list-none p-0">
    {stages.map((stage) => (
      <li class="border-b border-rule" id={stage.id}>
        <div class="flex gap-s py-m sm:gap-m">
          <div class="shrink-0" aria-hidden="true">
            <span
              class="data block text-step-3 leading-none font-semibold tabular-nums"
              style="color: var(--spot)"
              data-number
            >
              {String(stage.n).padStart(2, "0")}
            </span>
          </div>

          <div class="min-w-0 flex-1">
            <details class="group">
              <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <h3 class="inline" data-title>{stage.title}</h3>
                <span
                  class="ml-xs inline-flex items-center gap-1 align-middle text-step--1 font-medium"
                  style="color: var(--spot)"
                >
                  <span class="group-open:hidden">Open</span>
                  <span class="hidden group-open:inline">Close</span>
                  <Icon
                    name="lucide:chevron-down"
                    size={15}
                    class="transition-transform group-open:rotate-180"
                    aria-hidden="true"
                  />
                </span>
                <span class="mt-2xs block text-ink-2">{stage.summary}</span>
              </summary>

              <div class="mt-s">
                {stage.detail.map((para) => (
                  <p class="measure text-ink-2">{para}</p>
                ))}

                <dl class="mt-s grid grid-cols-1 gap-x-m gap-y-s border-t border-rule pt-s sm:grid-cols-2">
                  {facts.map((f) => (
                    <div>
                      <dt class="flex items-center gap-1.5 text-step--1 font-semibold">
                        <Icon
                          name={`lucide:${f.icon}`}
                          size={15}
                          style={f.accent ? "color: var(--spot)" : "color: var(--muted)"}
                          aria-hidden="true"
                        />
                        <span style={f.accent ? "color: var(--spot)" : undefined}>{f.label}</span>
                      </dt>
                      <dd class="mt-2xs mb-0 text-step--1 text-ink-2">{stage[f.key]}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </details>

            <label class="mt-s inline-flex cursor-pointer items-center gap-xs select-none">
              <input type="checkbox" class="h-4 w-4" data-stage={stage.id} />
              <span class="text-step--1 font-medium" data-stage-label>Mark complete</span>
            </label>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <button
    type="button"
    class="mt-s hidden cursor-pointer items-center gap-1.5 border-0 bg-transparent p-0 text-step--1 font-medium underline"
    style="color: var(--spot)"
    data-reset
  >
    Reset progress
  </button>
</div>
