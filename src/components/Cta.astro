---
import { Icon } from "astro-icon/components";
import config from "../../site.config.ts";
import { whatsappUrl } from "@uaeprop/site-kit/leads";

/**
 * Section-level call to action.
 *
 * No caption, no supporting line. The button is the only thing here, and the
 * space around it is what makes it read. (CLAUDE.md §6.2a)
 */
interface Props {
  /** The ask, written as the reader's own words. */
  label: string;
  /** Prefilled into the WhatsApp message so the source is obvious. */
  context: string;
  icon?: string;
}

const { label, context, icon = "message-circle" } = Astro.props;

const href = whatsappUrl(config, {
  message: `Hi, I'm reading ${config.brand}. ${context}`,
});
---

{/* Block wrapper: .cta is inline-flex, so margins on it collapse unpredictably
    against sibling blocks. The wrapper owns the vertical rhythm. */}
<div class="mt-l">
  <a
    href={href}
    rel="noopener noreferrer"
    target="_blank"
    class="cta cta-block"
  >
    <Icon name={`lucide:${icon}`} size={19} aria-hidden="true" />
    <span>{label}</span>
    <Icon name="lucide:arrow-up-right" size={17} aria-hidden="true" />
  </a>
</div>
