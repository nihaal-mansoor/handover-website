---
import { Icon } from "astro-icon/components";
import config from "../../site.config.ts";
import { disclaimer } from "@uaeprop/site-kit";
import { whatsappUrl, whatsappDisplay } from "@uaeprop/site-kit/leads";

const year = new Date().getFullYear();
const wa = whatsappUrl(config);
---

<footer class="mt-xl border-t border-rule">
  <div class="shell grid gap-m py-l md:grid-cols-[2fr_1fr]">
    <div>
      <h3 class="m-0">About this site</h3>
      <!-- Required on every page. Do not soften. (CLAUDE.md §1.4) -->
      <p class="measure mt-xs mb-0 text-step--1 text-ink-2">{disclaimer(config.brand)}</p>
    </div>

    <div>
      <h3 class="m-0">Contact</h3>
      <ul class="mt-xs m-0 list-none space-y-xs p-0 text-step--1">
        <li>
          <a href={wa} rel="noopener noreferrer" target="_blank"
            class="inline-flex items-center gap-xs">
            <Icon name="lucide:message-circle" size={16} aria-hidden="true" />
            WhatsApp {whatsappDisplay(config.contact.whatsapp)}
          </a>
        </li>
        <li>
          <a href={`mailto:${config.contact.email}`} class="inline-flex items-center gap-xs">
            <Icon name="lucide:mail" size={16} aria-hidden="true" />
            {config.contact.email}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="shell flex flex-wrap justify-between gap-s border-t border-rule py-s">
    <p class="meta m-0">&copy; {year} {config.brand}</p>
    <nav aria-label="Legal">
      <ul class="m-0 flex list-none gap-m p-0 text-step--1">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</footer>
