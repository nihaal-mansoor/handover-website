---
import { Icon } from "astro-icon/components";
import config from "../../site.config.ts";
import { CONSENT_TEXT } from "@uaeprop/site-kit";
import { whatsappUrl, whatsappDisplay } from "@uaeprop/site-kit/leads";

const wa = whatsappUrl(config, {
  message: `Hi, I've been reading ${config.brand} about the Dubai buying process. I'd like some help.`,
});
const turnstileKey = import.meta.env["PUBLIC_TURNSTILE_SITE_KEY"] ?? "";

const field =
  "w-full bg-[var(--paper)] px-s py-xs text-step-0 border-0 border-b-2 border-rule focus:border-[var(--focus)] focus:outline-none";
---

<section id="ask" class="pt-l pb-m">
  <div class="grid gap-l md:grid-cols-[1.05fr_1fr]">
    <div>
      <h2>Ask someone who does this every week</h2>
      <p class="measure mt-s text-ink-2">
        We are not brokers. We publish this guide. If you want to speak to
        someone licensed, tell us where you are in the process and we will introduce
        you to a broker who handles that stage. No cost to you.
      </p>

      <a href={wa} rel="noopener noreferrer" target="_blank" class="cta cta-primary mt-m">
        <Icon name="lucide:message-circle" size={20} aria-hidden="true" />
        <span>WhatsApp {whatsappDisplay(config.contact.whatsapp)}</span>
        <Icon name="lucide:arrow-up-right" size={17} aria-hidden="true" />
      </a>
      <p class="meta mt-2xs">Usually the fastest way to get an answer.</p>

      <ul class="mt-m m-0 list-none space-y-xs p-0">
        {[
          ["shield-check", "We never sell your details on to a list."],
          ["clock", "Most questions answered the same day."],
          ["scale", "Independent. We hold no listings and sell nothing."],
        ].map(([icon, text]) => (
          <li class="flex items-start gap-xs text-step--1 text-ink-2">
            <Icon
              name={`lucide:${icon}`}
              size={17}
              style="color: var(--ok); margin-top: 0.15rem"
              aria-hidden="true"
            />
            <span>{text}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="panel">
      <form id="lead-form" novalidate>
        <h3 class="m-0">Or send a message</h3>

        <!-- Honeypot: hidden from users and from assistive tech. (§4.4) -->
        <div aria-hidden="true" style="position:absolute;left:-9999px" tabindex="-1">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="mt-s space-y-s">
          <div>
            <label class="block text-step--1 font-medium mb-2xs" for="name">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name"
              aria-describedby="name-error" class={field} />
            <p id="name-error" class="m-0 mt-2xs text-step--1" style="color: var(--spot)" hidden></p>
          </div>

          <div>
            <label class="block text-step--1 font-medium mb-2xs" for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email"
              aria-describedby="email-error" class={field} />
            <p id="email-error" class="m-0 mt-2xs text-step--1" style="color: var(--spot)" hidden></p>
          </div>

          <div>
            <label class="block text-step--1 font-medium mb-2xs" for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel"
              placeholder="+971 50 000 0000" aria-describedby="phone-error" class={field} />
            <p id="phone-error" class="m-0 mt-2xs text-step--1" style="color: var(--spot)" hidden></p>
          </div>

          <div>
            <label class="block text-step--1 font-medium mb-2xs" for="message">
              Where are you in the process? (optional)
            </label>
            <textarea id="message" name="message" rows="3" aria-describedby="message-error"
              class={field}></textarea>
            <p id="message-error" class="m-0 mt-2xs text-step--1" style="color: var(--spot)" hidden></p>
          </div>

          <!-- Unticked by default, and its exact wording is stored with the lead. (§4.4) -->
          <div>
            <label class="flex cursor-pointer items-start gap-xs text-step--1 text-ink-2">
              <input id="consent" name="consent" type="checkbox" required
                aria-describedby="consent-error" class="mt-1 h-4 w-4 shrink-0" />
              <span>{CONSENT_TEXT}</span>
            </label>
            <p id="consent-error" class="m-0 mt-2xs text-step--1" style="color: var(--spot)" hidden></p>
          </div>

          {turnstileKey && (
            <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto"></div>
          )}

          <button type="submit" class="cta cta-primary w-full justify-center disabled:opacity-50">
            <Icon name="lucide:send" size={18} aria-hidden="true" />
            <span>Send message</span>
          </button>

          <p id="form-status" role="status" aria-live="polite"
            class="m-0 text-step--1 text-ink-2" hidden></p>
        </div>
      </form>

      <noscript>
        <p class="meta mt-s mb-0">
          This form needs JavaScript. Message us on
          <a href={wa} rel="noopener noreferrer">WhatsApp</a> or email
          <a href={`mailto:${config.contact.email}`}>{config.contact.email}</a> instead.
        </p>
      </noscript>
    </div>
  </div>
</section>

{turnstileKey && (
  <script is:inline defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}
