---
import config from "../../site.config.ts";
import { CONSENT_TEXT } from "@uaeprop/site-kit";
import { whatsappUrl, whatsappDisplay } from "@uaeprop/site-kit/leads";

const wa = whatsappUrl(config, {
  message: `Hi, I've been reading ${config.brand} about the Dubai buying process. I'd like some help.`,
});
const turnstileKey = import.meta.env["PUBLIC_TURNSTILE_SITE_KEY"] ?? "";
---

<section id="ask" class="mt-16 border-t-[3px] border-[var(--rule-heavy)] pt-10">
  <div class="grid gap-10 md:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="label mb-3">Get help</p>
      <h2>Ask someone who does this every week</h2>
      <p class="measure mt-4 text-ink-2">
        We are not brokers &mdash; we publish this guide. If you want to speak to
        someone licensed, tell us where you are in the process and we will introduce
        you to a broker who handles that stage. No cost to you.
      </p>

      <a
        href={wa}
        rel="noopener noreferrer"
        target="_blank"
        class="mt-6 inline-flex items-center gap-3 border-2 border-[var(--rule-heavy)] px-6 py-3.5 no-underline transition-colors hover:bg-[var(--sunk)]"
      >
        <span class="label" style="color: var(--spot)">WhatsApp</span>
        <span class="data font-medium">{whatsappDisplay(config.contact.whatsapp)}</span>
      </a>
      <p class="mt-3 mb-0 text-sm text-muted">Usually the fastest way to get an answer.</p>
    </div>

    <div class="border border-rule bg-[var(--surface)] p-6">
      <form id="lead-form" novalidate>
        <p class="label mb-4">Or send a message</p>

        <!-- Honeypot: hidden from users and from assistive tech. (§4.4) -->
        <div aria-hidden="true" style="position:absolute;left:-9999px" tabindex="-1">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="space-y-4">
          <div>
            <label class="label block mb-1.5" for="name">Name</label>
            <input
              id="name" name="name" type="text" required autocomplete="name"
              aria-describedby="name-error"
              class="w-full border border-rule bg-[var(--paper)] px-3 py-2.5 text-[0.95rem]"
            />
            <p id="name-error" class="m-0 mt-1 text-sm" style="color: var(--spot)" hidden></p>
          </div>

          <div>
            <label class="label block mb-1.5" for="email">Email</label>
            <input
              id="email" name="email" type="email" required autocomplete="email"
              aria-describedby="email-error"
              class="w-full border border-rule bg-[var(--paper)] px-3 py-2.5 text-[0.95rem]"
            />
            <p id="email-error" class="m-0 mt-1 text-sm" style="color: var(--spot)" hidden></p>
          </div>

          <div>
            <label class="label block mb-1.5" for="phone">Phone</label>
            <input
              id="phone" name="phone" type="tel" required autocomplete="tel"
              placeholder="+971 50 000 0000" aria-describedby="phone-error"
              class="w-full border border-rule bg-[var(--paper)] px-3 py-2.5 text-[0.95rem]"
            />
            <p id="phone-error" class="m-0 mt-1 text-sm" style="color: var(--spot)" hidden></p>
          </div>

          <div>
            <label class="label block mb-1.5" for="message">
              Where are you in the process? <span class="normal-case">(optional)</span>
            </label>
            <textarea
              id="message" name="message" rows="3" aria-describedby="message-error"
              class="w-full border border-rule bg-[var(--paper)] px-3 py-2.5 text-[0.95rem]"
            ></textarea>
            <p id="message-error" class="m-0 mt-1 text-sm" style="color: var(--spot)" hidden></p>
          </div>

          <!-- Unticked by default, and its exact wording is stored with the lead. (§4.4) -->
          <div>
            <label class="flex cursor-pointer items-start gap-2.5 text-sm text-ink-2">
              <input
                id="consent" name="consent" type="checkbox" required
                aria-describedby="consent-error" class="mt-1 h-4 w-4 shrink-0"
              />
              <span>{CONSENT_TEXT}</span>
            </label>
            <p id="consent-error" class="m-0 mt-1 text-sm" style="color: var(--spot)" hidden></p>
          </div>

          {turnstileKey && (
            <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto"></div>
          )}

          <button
            type="submit"
            class="w-full cursor-pointer border-2 border-[var(--rule-heavy)] bg-[var(--rule-heavy)] px-6 py-3 text-[var(--paper)] transition-opacity hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-50"
          >
            <span class="label" style="color: inherit">Send message</span>
          </button>

          <p
            id="form-status" role="status" aria-live="polite"
            class="m-0 text-sm text-ink-2" hidden
          ></p>
        </div>
      </form>

      <noscript>
        <p class="m-0 mt-4 border-t border-rule pt-4 text-sm text-ink-2">
          This form needs JavaScript. Message us on
          <a href={wa} rel="noopener noreferrer">WhatsApp</a> or email
          <a href={`mailto:${config.contact.email}`}>{config.contact.email}</a> instead.
        </p>
      </noscript>
    </div>
  </div>
</section>

{turnstileKey && (
  <script
    is:inline
    defer
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  ></script>
)}
