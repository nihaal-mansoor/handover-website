---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Cta from "../components/Cta.astro";
import ProcessChecklist from "../components/ProcessChecklist.astro";
import { Icon } from "astro-icon/components";
import { STAGES, COSTS, FAQS, SOURCE } from "../content/process.ts";
import config from "../../site.config.ts";
import { originOf, sourcedAsOf } from "@uaeprop/site-kit";

const title = "How buying property in Dubai actually works | Handover";
const description =
  "The seven stages of a Dubai property purchase, what each one costs, who signs what, and where transactions actually stall. Independent, no listings.";

const origin = originOf(config);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      name: "How to buy property in Dubai",
      description,
      totalTime: "P28D",
      step: STAGES.map((s) => ({
        "@type": "HowToStep",
        position: s.n,
        name: s.title,
        text: s.summary,
        url: `${origin}/#${s.id}`,
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: FAQS.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
    {
      "@type": "WebSite",
      name: config.brand,
      url: origin,
      description: config.tagline,
      publisher: { "@type": "Organization", name: config.brand, url: origin },
    },
  ],
};

const reviewed = new Date(`${SOURCE.reviewed}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

const decisions = [
  {
    icon: "git-branch",
    q: "Is it ready or off-plan?",
    a: "A ready property is bought from an owner. Off-plan is bought from the developer, follows a payment schedule into escrow, and skips two of the stages below.",
  },
  {
    icon: "landmark",
    q: "Are you financing?",
    a: "A mortgage adds a valuation, and that is where most Dubai deals collapse. Get pre-approved before you sign, not after.",
  },
];
---

<Base title={title} description={description} schema={schema}>
  <article class="shell">
    <!-- Lede -->
    <section class="border-b border-rule pt-xl pb-l">
      <h1 class="max-w-[19ch]">How buying property in Dubai actually works</h1>
      <p class="measure mt-m text-step-1 text-ink-2">
        Seven stages, from the first signature to the title deed. What each costs,
        who signs it, and where transactions actually stall.
      </p>

      <Cta
        variant="primary"
        icon="compass"
        label="Tell us where you are in the process"
        context="I'd like help working out which stage I'm at."
      />

      <p class="meta mt-l mb-0">
        Reviewed {reviewed} &middot; No listings &middot; Nothing is sold here
      </p>
    </section>

    <!-- Two decisions -->
    <section class="border-b border-rule pt-xl pb-l">
      <h2>Before anything else</h2>
      <p class="measure mt-xs text-ink-2">
        Two things decide how your purchase will go, and both are settled before you
        view a single property.
      </p>

      <div class="mt-l grid gap-s md:grid-cols-2">
        {decisions.map((d) => (
          <div class="panel">
            <div class="flex items-center gap-xs">
              <Icon name={`lucide:${d.icon}`} size={20} style="color: var(--spot)" aria-hidden="true" />
              <h3 class="m-0">{d.q}</h3>
            </div>
            <p class="mt-xs mb-0 text-ink-2">{d.a}</p>
          </div>
        ))}
      </div>

      <Cta
        icon="help-circle"
        label="Not sure which applies to you?"
        context="I'm not sure whether I should be looking at ready or off-plan."
      />
    </section>

    <!-- The spine -->
    <section id="stages" class="border-b border-rule pt-xl pb-l">
      <h2>The seven stages</h2>
      <p class="measure mt-xs mb-l text-ink-2">
        Open any stage for the detail. Tick them off as you go.
      </p>

      <ProcessChecklist stages={STAGES} />

      <Cta
        icon="life-buoy"
        label="Stuck on one of these stages?"
        context="I'm stuck on one of the seven stages and need help getting past it."
      />
    </section>

    <!-- Costs -->
    <section id="costs" class="border-b border-rule pt-xl pb-l">
      <h2>What it costs to transfer</h2>
      <p class="measure mt-xs text-ink-2">
        Budget <strong>6.5% to 7%</strong> of the purchase price in total if you are paying
        cash, and <strong>7.5% to 9%</strong> if you are financing. The 4% transfer fee is
        the part everyone knows about; the rest is what surprises people.
      </p>

      <div class="mt-l overflow-x-auto">
        <table class="w-full min-w-[38rem] border-collapse text-left">
          <caption class="sr-only">
            Indicative transaction costs for a Dubai property purchase
          </caption>
          <thead>
            <tr class="border-b-2 border-[var(--rule-heavy)]">
              <th scope="col" class="py-xs pr-s text-step--1 font-semibold">Item</th>
              <th scope="col" class="py-xs pr-s text-step--1 font-semibold">Typical amount</th>
              <th scope="col" class="py-xs pr-s text-step--1 font-semibold">Usually paid by</th>
            </tr>
          </thead>
          <tbody>
            {COSTS.map((row) => (
              <tr class="border-b border-rule align-top">
                <th scope="row" class="py-s pr-s font-medium">{row.item}</th>
                <td class="data py-s pr-s whitespace-nowrap">{row.amount}</td>
                <td class="py-s pr-s">
                  <span>{row.payer}</span>
                  {row.note && <span class="meta mt-2xs block">{row.note}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="meta mt-s mb-0">
        {sourcedAsOf(SOURCE.name, SOURCE.reviewed)} Fees change, so confirm current
        figures with the Dubai Land Department before you budget.
      </p>

      <Cta
        icon="calculator"
        label="Get these costs worked out for your budget"
        context="Can you work out the total transaction cost for my budget?"
      />
    </section>

    <!-- FAQ -->
    <section id="questions" class="border-b border-rule pt-xl pb-l">
      <h2>What buyers ask most</h2>

      <dl class="mt-l grid gap-s md:grid-cols-2">
        {FAQS.map((faq) => (
          <div class="panel">
            <dt class="text-step-1 font-medium" style="font-family: var(--font-display)">
              {faq.q}
            </dt>
            <dd class="mt-xs mb-0 text-ink-2">{faq.a}</dd>
          </div>
        ))}
      </dl>

      <Cta
        icon="message-circle-question"
        label="Ask something that isn't here"
        context="I have a question that isn't answered in your FAQ."
      />
    </section>

    <LeadForm />
  </article>
</Base>
