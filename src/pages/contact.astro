---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";

const title = "Contact | Handover";
const description =
  "Ask a question about the Dubai buying process, or get introduced to a licensed broker.";
---

<Base title={title} description={description}>
  <article class="shell py-12 md:py-16">
    <p class="label mb-4">Contact</p>
    <h1 class="max-w-[15ch] text-[clamp(2rem,4.5vw,3rem)]">Ask a question</h1>
    <p class="measure mt-6 text-[1.1rem] text-ink-2">
      Tell us where you are in the process. If it is a question about how something works,
      we will answer it. If you need someone licensed to act for you, we will introduce you
      to a broker who handles that stage.
    </p>
    <LeadForm />
  </article>
</Base>
