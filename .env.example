# Local development uses the Postgres already on this machine.
DATABASE_URL="postgresql://localhost:5432/handover"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4330"

# Google sign-in. Create OAuth credentials in Google Cloud Console and set the
# redirect URI to <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Notifies the moderator that something is waiting. Optional in development.
RESEND_API_KEY=""
LEAD_FROM_EMAIL=""
MODERATOR_EMAIL=""

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Empty disables GA entirely. GA only loads for readers who accept the consent banner.
NEXT_PUBLIC_GA_ID=""

# Vercel Blob, for post image uploads. Injected automatically on Vercel.
BLOB_READ_WRITE_TOKEN=""
