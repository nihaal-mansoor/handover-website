# site-kit server-side secrets. Copy to .env in each SITE, never commit .env.
# Only PUBLIC_* variables may be referenced from client code. (CLAUDE.md §4.3)

# Neon Postgres — shared leads + rate_limit tables across the portfolio
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Cloudflare Turnstile — the secret is server-side, the site key is public
TURNSTILE_SECRET_KEY="0x0000000000000000000000000000000000"
PUBLIC_TURNSTILE_SITE_KEY="0x0000000000000000000000"

# Resend — transactional email for lead notifications
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
LEAD_FROM_EMAIL="leads@your-sending-domain.com"
